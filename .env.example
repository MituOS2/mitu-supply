# Puerto y host del servidor HTTP
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Rutas relativas al directorio del proyecto (opcional)
# DB_PATH=server/data/store.sqlite
# UPLOAD_DIR=server/storage/uploads
# DIST_WEB_DIR=server/dist-web

# Secretos generados automaticamente por iniciar.bat / iniciar.sh en .env
SESSION_PEPPER=
IP_HASH_SALT=

# Bootstrap inicial de cuenta administrador (solo se usa si la tabla users no tiene admins)
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_EMAIL=admin@tbdsupply.local
ADMIN_BOOTSTRAP_PASSWORD=

# Opciones avanzadas de seguridad y entorno (opcional)
# ALLOWED_ORIGINS=https://tudominio.com
# TRUST_PROXY=false
# COOKIE_SECURE=false
# LOCAL_AUTO_ADMIN=true
# SEED_DEMO_CATALOG=false
