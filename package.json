{
  "name": "tbd-supply",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda web creativa TBD.SUPPLY con UI nativa Miuix (Kotlin/Compose WebAssembly) + Node.js (>= 24) sin dependencias + SQLite",
  "license": "MIT",
  "author": "TBD.SUPPLY Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/MituOS2/mitu-supply.git"
  },
  "homepage": "https://github.com/MituOS2/mitu-supply#readme",
  "bugs": {
    "url": "https://github.com/MituOS2/mitu-supply/issues"
  },
  "keywords": [
    "ecommerce",
    "miuix",
    "compose-multiplatform",
    "kotlin-wasm",
    "nodejs",
    "sqlite",
    "zero-dependencies",
    "security"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "seed": "node server/src/db/runSeed.js",
    "build": "node -e \"if (!require('fs').existsSync('server/dist-web/index.html')) process.exit(1)\"",
    "build:netlify": "node -e \"console.log('Netlify: Desplegando interfaz WebAssembly...');\"",
    "test": "node --test server/tests/integration.test.js server/tests/security.test.js",
    "test:security": "node --test server/tests/security.test.js"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
