# EditorConfig ayuda a mantener estilos de codigo consistentes entre distintos IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,ps1}]
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab
