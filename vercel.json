{
  "outputDirectory": "server/dist-web",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?route=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.js?route="
    },
    {
      "source": "/((?!api/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
